<Window x:Class="DotaComboBoard.MetaCounterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Counter"
        Width="940"
        Height="1080"
        MinWidth="720"
        MinHeight="620"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="META COUNTER" FontSize="23" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="REFRESH DATA" Margin="0,0,6,0" Click="RefreshButton_Click" />
                <Button x:Name="CloseButton" Content="CLOSE" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="READING CURRENT META..." Foreground="{StaticResource AccentBrush}" FontSize="18" />
                    <ProgressBar Width="260" Height="4" Margin="0,14,0,0" IsIndeterminate="True" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorTitleText" Text="META DATA UNAVAILABLE" Foreground="{StaticResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,16" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="RetryButton" Content="TRY AGAIN" HorizontalAlignment="Center" Click="RefreshButton_Click" />
                </StackPanel>

                <ScrollViewer x:Name="ResultScroll" Visibility="Collapsed" Padding="14,14,8,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecommendationItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="#141920" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Image Source="{Binding IconPath}" Width="82" Height="82" Stretch="UniformToFill" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Hero}" Margin="0,7,0,0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PickRateText}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                            <TextBlock Text="{Binding WinRateText}" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PlanLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PlanTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#23352D" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding MatchupScoreText}" Foreground="#71D09B" FontWeight="Bold" />
                                                </Border>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Picks}" Margin="0,9,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,7,0" Background="#1B242D" CornerRadius="5" Padding="6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding IconPath}" Width="34" Height="34" Stretch="UniformToFill" />
                                                                <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Hero}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Role}" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Why}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Adjustment, StringFormat='→ {0}'}" Margin="0,5,0,0" Foreground="#F4C46A" TextWrapping="Wrap" />
                                            <Border Margin="0,9,0,0" Background="#1A222B" CornerRadius="5" Padding="8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding BackupPlanLabel}" Foreground="{StaticResource SecondaryText}" />
                                                    <TextBlock Text="{Binding BackupPlanTitle}" Margin="8,0,0,0" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="2,9,2,0" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
