<Window x:Class="DotaComboBoard.BrowserSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Search Sync" Width="920" Height="780" MinWidth="700" MinHeight="560"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="{DynamicResource AppFont}" FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#181F27" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="PUBLIC WEB SEARCH SYNC" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="HeaderDetailText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Top" Content="CLOSE" Click="CloseButton_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Margin="0,1,8,0" Fill="#F4C46A" />
                        <TextBlock x:Name="ConnectionText" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionDetailText" Margin="18,4,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#11161C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="PairingLabelText" Text="PAIRING" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="PairingCodeText" Margin="10,0,0,0" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#71D6B1" /></StackPanel>
                    </Border>
                    <Button x:Name="CopyCodeButton" Margin="8,0,0,0" Content="COPY" Click="CopyCodeButton_Click" />
                    <Button x:Name="OpenExtensionButton" Margin="8,0,0,0" Content="EXTENSION FOLDER" Click="OpenExtensionButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" MinHeight="42" Padding="10,8" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="120" Content="SEARCH" Click="SearchButton_Click" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="SourcesLabelText" Margin="0,2,12,0" Text="SOURCES" Foreground="{StaticResource SecondaryText}" FontWeight="Bold" />
                    <CheckBox x:Name="ValveCheckBox" Margin="0,0,14,0" Content="Valve / dota2.com" IsChecked="True" />
                    <CheckBox x:Name="D2PtCheckBox" Margin="0,0,14,0" Content="D2PT" IsChecked="True" />
                    <CheckBox x:Name="DotabuffCheckBox" Margin="0,0,14,0" Content="Dotabuff" IsChecked="True" />
                    <CheckBox x:Name="GeneralCheckBox" Content="General web" IsChecked="True" />
                </WrapPanel>
                <TextBlock x:Name="SearchStatusText" Grid.Row="2" Margin="0,9,0,8" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Background="#11161C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><Border Background="#25313C" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding Source}" Foreground="#71D6B1" FontSize="10" FontWeight="Bold" /></Border><TextBlock Margin="8,0,0,0" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" /></StackPanel>
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Snippet}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0" Text="{Binding Url}" Foreground="#6EB8FF" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="OPEN" Tag="{Binding Url}" Click="OpenResultButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="DisclaimerText" Grid.Row="5" Margin="2,10,2,0" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
