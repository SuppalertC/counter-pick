<Window x:Class="DotaComboBoard.McpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local MCP Server" Width="860" Height="720" MinWidth="680" MinHeight="520"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="{DynamicResource AppFont}" FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#181F27" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="13" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="LOCAL MCP SERVER" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Top" Content="CLOSE" Click="CloseButton_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,1,8,0" Fill="#71D6B1" />
                        <TextBlock x:Name="StatusText" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ActivityText" Margin="18,4,0,0" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <Button x:Name="CopyConfigButton" Grid.Column="1" Content="COPY CLIENT CONFIG" Click="CopyConfigButton_Click" />
            </Grid>
        </Border>

        <TabControl Grid.Row="4">
            <TabItem x:Name="ConnectTab" Header="CONNECT">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PluginNameLabelText" Text="PLUGIN NAME" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                                <TextBox x:Name="PluginNameBox" Margin="0,5,0,0" IsReadOnly="True" FontFamily="Consolas" Padding="9" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="TransportLabelText" Text="TRANSPORT" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                                <TextBox x:Name="TransportBox" Margin="0,5,0,0" IsReadOnly="True" FontFamily="Consolas" Padding="9" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EndpointLabelText" Text="ENDPOINT" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="EndpointBox" IsReadOnly="True" FontFamily="Consolas" Padding="9" />
                            <Button x:Name="CopyEndpointButton" Grid.Column="1" Margin="8,0,0,0" Content="COPY" Click="CopyEndpointButton_Click" />
                        </Grid>
                        <TextBlock x:Name="TokenLabelText" Text="ACCESS TOKEN" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="TokenBox" IsReadOnly="True" FontFamily="Consolas" Padding="9" />
                            <Button x:Name="CopyTokenButton" Grid.Column="1" Margin="8,0,0,0" Content="COPY" Click="CopyTokenButton_Click" />
                        </Grid>
                        <TextBlock x:Name="AuthLabelText" Text="AUTH HEADER" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                        <TextBox x:Name="AuthBox" Margin="0,5,0,12" IsReadOnly="True" FontFamily="Consolas" Padding="9" />
                        <TextBlock x:Name="ConfigLabelText" Text="GENERIC MCP CLIENT CONFIG" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" />
                        <TextBox x:Name="ConfigBox" Margin="0,5,0,0" MinHeight="190" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ToolsTab" Header="TOOLS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="get_app_context" /><TextBlock x:Name="ContextToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="get_combo_generation_package" /><TextBlock x:Name="GenerationToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="list_combos" /><TextBlock x:Name="ListToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="validate_combo_pack" /><TextBlock x:Name="ValidateToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="import_combo_pack" /><TextBlock x:Name="ImportToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontWeight="Bold" Text="search_public_web" /><TextBlock x:Name="SearchToolText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SecurityTab" Header="SECURITY">
                <TextBlock x:Name="SecurityText" Margin="16" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </TabItem>
        </TabControl>

        <TextBlock x:Name="FooterText" Grid.Row="5" Margin="2,10,2,0" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
