<Window x:Class="DotaComboBoard.HeroCounterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hero Counter Finder" Width="1180" Height="820" MinWidth="820" MinHeight="600"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="{DynamicResource AppFont}" FontSize="14" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CounterCard" Color="#161C23" />
        <SolidColorBrush x:Key="CounterRaised" Color="#1C242D" />
        <SolidColorBrush x:Key="CounterMuted" Color="#11161C" />
        <SolidColorBrush x:Key="StrengthColor" Color="#D95757" />
        <SolidColorBrush x:Key="AgilityColor" Color="#64C987" />
        <SolidColorBrush x:Key="IntelligenceColor" Color="#62A9E8" />
        <SolidColorBrush x:Key="UniversalColor" Color="#B58AE5" />

        <Style x:Key="CounterTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,8" />
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBody" Margin="0,0,5,0" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBody" Property="Background" Value="#202832" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter TargetName="TabBody" Property="Background" Value="#202832" />
                                <Setter TargetName="TabBody" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttributeHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroWrapPanelStyle" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CounterScrollerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="IsDeferredScrollingEnabled" Value="False" />
            <Setter Property="Padding" Value="0,0,3,0" />
        </Style>

        <DataTemplate x:Key="HeroPickerTemplate">
            <Button Width="82" Height="66" Margin="3" Padding="3" Tag="{Binding}"
                    AutomationProperties.Name="{Binding Name}" Click="HeroButton_Click">
                <StackPanel>
                    <Image Source="{Binding IconPath}" Width="34" Height="34" Stretch="UniformToFill" HorizontalAlignment="Center" />
                    <TextBlock Margin="1,2,1,0" Text="{Binding Name}" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TeamHeroPickerTemplate">
            <Button Width="42" Height="43" Margin="1" Padding="1" Tag="{Binding}"
                    AutomationProperties.Name="{Binding Name}" Click="TeamHeroButton_Click"
                    ToolTip="{Binding Name}">
                <StackPanel>
                    <Image Source="{Binding IconPath}" Width="23" Height="23" Stretch="UniformToFill" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,1,0,0" Text="{Binding Name}" FontSize="7.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SelectedEnemyTemplate">
            <Button Width="124" Height="46" Margin="0,0,6,0" Padding="5" Tag="{Binding}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                    Click="RemoveEnemyButton_Click" ToolTip="Remove from enemy team">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <Image Width="30" Height="30" Source="{Binding IconPath}" Stretch="UniformToFill" />
                    <TextBlock Grid.Column="1" Margin="5,0" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="×" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="MatchupTemplate">
            <Border Margin="0,0,0,6" Background="{StaticResource CounterCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="{Binding IconPath}" Width="34" Height="34" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Hero}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TargetChipTemplate">
            <Border Margin="0,3,5,0" Padding="6,2" Background="#2B1E20" BorderBrush="#61363A" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="#F29A91" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TeamRecommendationTemplate">
            <Border Margin="0,0,0,7" Background="{StaticResource CounterCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Width="40" Height="40" Source="{Binding IconPath}" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Hero}" FontWeight="Bold" />
                        <TextBlock Text="{Binding ScoreText}" FontSize="10" Foreground="#71D09B" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding StrongAgainst}" ItemTemplate="{StaticResource TargetChipTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,0" Text="{Binding Reason}" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TeamLineupTemplate">
            <Border Margin="0,0,0,10" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Margin="0,3,0,9" Text="{Binding Strategy}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Picks}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="194" Margin="0,0,7,7" Background="{StaticResource CounterMuted}" CornerRadius="6" Padding="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Width="34" Height="34" Source="{Binding IconPath}" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Hero}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Role}" FontSize="9" Foreground="{StaticResource SecondaryText}" />
                                            <TextBlock Text="{Binding Targets}" FontSize="9" Foreground="#F29A91" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="HERO COUNTER FINDER" FontSize="23" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Text="Search one hero or build a full 5v5 counter draft." Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Content="CLOSE" Click="CloseButton_Click" />
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" Background="#171E26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Padding="4,8" Background="Transparent" Foreground="{StaticResource PrimaryText}"
                             BorderThickness="0" CaretBrush="{StaticResource PrimaryText}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="ClearSearchButton" Grid.Column="2" Margin="4" Padding="10,5" Content="×" ToolTip="Clear search" Click="ClearSearchButton_Click" />
                    <Button x:Name="SearchButton" Grid.Column="3" Margin="0,4,4,4" Padding="14,5" Content="SEARCH" Background="{StaticResource AccentBrush}" Click="SearchButton_Click" />
                </Grid>
                <TextBlock x:Name="SearchStatusText" Margin="35,0,8,6" Foreground="{StaticResource SecondaryText}" FontSize="10" />
            </StackPanel>
        </Border>

        <TabControl x:Name="ModeTabs" Grid.Row="2" Style="{StaticResource CounterTabControlStyle}">
            <TabItem x:Name="SingleModeTab" Header="1 HERO">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="0.46*" /><RowDefinition Height="10" /><RowDefinition Height="0.54*" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <TabControl x:Name="AttributeTabs" Style="{StaticResource CounterTabControlStyle}">
                            <TabItem Header="STR"><ScrollViewer Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="StrengthItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource HeroPickerTemplate}" /></ScrollViewer></TabItem>
                            <TabItem Header="AGI"><ScrollViewer Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="AgilityItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource HeroPickerTemplate}" /></ScrollViewer></TabItem>
                            <TabItem Header="INT"><ScrollViewer Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="IntelligenceItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource HeroPickerTemplate}" /></ScrollViewer></TabItem>
                            <TabItem Header="UNI"><ScrollViewer Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="UniversalItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource HeroPickerTemplate}" /></ScrollViewer></TabItem>
                        </TabControl>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <TextBlock x:Name="EmptyResultText" Text="Select a hero to view counters and favorable matchups." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <Grid x:Name="ResultPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="SelectedHeroIcon" Width="44" Height="44" Stretch="UniformToFill" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedHeroText" FontSize="19" FontWeight="Bold" />
                                        <TextBlock x:Name="SelectedHeroMetaText" Foreground="{StaticResource SecondaryText}" />
                                        <TextBlock x:Name="MatchupSourceText" Foreground="#F4C46A" FontSize="10" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" Style="{StaticResource CounterScrollerStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="CounterHeaderText" Text="DISADVANTAGED VS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,7" />
                                            <ItemsControl x:Name="CounterItems" ItemTemplate="{StaticResource MatchupTemplate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="AdvantageHeaderText" Text="ADVANTAGED VS" Foreground="#71D09B" FontWeight="Bold" Margin="0,0,0,7" />
                                            <ItemsControl x:Name="AdvantageItems" ItemTemplate="{StaticResource MatchupTemplate}" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="LoadingText" Text="LOADING MATCHUPS..." Foreground="{StaticResource AccentBrush}" />
                                <ProgressBar Width="240" Height="4" Margin="0,10,0,0" IsIndeterminate="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TeamModeTab" Header="5v5 VERSUS">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="EnemyTeamHeaderText" Text="ENEMY TEAM — SELECT 5" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedCountText" Margin="0,2,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ClearTeamButton" Margin="0,0,7,0" Content="CLEAR" Click="ClearTeamButton_Click" />
                            <Button x:Name="AnalyzeTeamButton" Content="ANALYZE 5v5" Background="{StaticResource AccentBrush}" IsEnabled="False" Click="AnalyzeTeamButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,0,0,7" Padding="6" MinHeight="54" Background="{StaticResource CounterMuted}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <ItemsControl x:Name="SelectedEnemyItems" ItemTemplate="{StaticResource SelectedEnemyTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid x:Name="TeamPickerPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#2A1B1D" CornerRadius="7,7,0,0" Padding="10,0"><TextBlock Text="●  STRENGTH" Foreground="{StaticResource StrengthColor}" Style="{StaticResource AttributeHeaderStyle}" /></Border>
                                    <ScrollViewer Grid.Row="1" Margin="5" Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="TeamStrengthItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource TeamHeroPickerTemplate}" /></ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#18271F" CornerRadius="7,7,0,0" Padding="10,0"><TextBlock Text="●  AGILITY" Foreground="{StaticResource AgilityColor}" Style="{StaticResource AttributeHeaderStyle}" /></Border>
                                    <ScrollViewer Grid.Row="1" Margin="5" Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="TeamAgilityItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource TeamHeroPickerTemplate}" /></ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#18232D" CornerRadius="7,7,0,0" Padding="10,0"><TextBlock Text="●  INTELLIGENCE" Foreground="{StaticResource IntelligenceColor}" Style="{StaticResource AttributeHeaderStyle}" /></Border>
                                    <ScrollViewer Grid.Row="1" Margin="5" Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="TeamIntelligenceItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource TeamHeroPickerTemplate}" /></ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="6" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#241D2C" CornerRadius="7,7,0,0" Padding="10,0"><TextBlock Text="●  UNIVERSAL" Foreground="{StaticResource UniversalColor}" Style="{StaticResource AttributeHeaderStyle}" /></Border>
                                    <ScrollViewer Grid.Row="1" Margin="5" Style="{StaticResource CounterScrollerStyle}"><ItemsControl x:Name="TeamUniversalItems" Style="{StaticResource HeroWrapPanelStyle}" ItemTemplate="{StaticResource TeamHeroPickerTemplate}" /></ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="TeamResultContainer" Visibility="Collapsed" Background="{StaticResource CounterRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <TextBlock x:Name="TeamEmptyResultText" Text="Select five enemy heroes, then analyze the full matchup." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                <StackPanel x:Name="TeamLoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TeamLoadingText" Text="SCORING 5v5 MATCHUPS..." Foreground="{StaticResource AccentBrush}" />
                                    <ProgressBar Width="280" Height="4" Margin="0,10,0,0" IsIndeterminate="True" />
                                </StackPanel>
                                <ScrollViewer x:Name="TeamResultScroller" Style="{StaticResource CounterScrollerStyle}" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ResultTitleText" Text="5v5 COUNTER RESULT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Button x:Name="BackToTeamPickerButton" Grid.Column="1" Content="← BACK TO HEROES" Click="BackToTeamPickerButton_Click" />
                                        </Grid>
                                        <Border Background="{StaticResource CounterMuted}" CornerRadius="7" Padding="10">
                                            <StackPanel>
                                                <TextBlock x:Name="AiSummaryHeaderText" Text="FAST AI SUMMARY" Foreground="#F4C46A" FontWeight="Bold" />
                                                <TextBlock x:Name="AiSummaryText" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="RecommendedHeroesHeaderText" Margin="0,15,0,7" Text="BEST COUNTER PICKS" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" />
                                        <ItemsControl x:Name="RecommendedHeroItems" ItemTemplate="{StaticResource TeamRecommendationTemplate}" />
                                        <TextBlock x:Name="RecommendedTeamsHeaderText" Margin="0,15,0,7" Text="TOP 3 COUNTER TEAMS" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" />
                                        <ItemsControl x:Name="RecommendedTeamItems" ItemTemplate="{StaticResource TeamLineupTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="2,10,2,0" Foreground="{StaticResource SecondaryText}" FontSize="11" />
    </Grid>
</Window>
